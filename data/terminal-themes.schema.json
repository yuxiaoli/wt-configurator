{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "source": {
      "type": "object",
      "properties": {
        "id": {
          "const": "terminal"
        },
        "url": {
          "const": "https://terminalcolors.com/"
        }
      },
      "required": [
        "id",
        "url"
      ],
      "additionalProperties": false
    },
    "started_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$",
      "description": "UTC timestamp."
    },
    "finished_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$",
      "description": "UTC timestamp."
    },
    "status": {
      "enum": [
        "complete",
        "partial"
      ]
    },
    "discovery": {
      "type": "object",
      "properties": {
        "complete": {
          "type": "boolean"
        },
        "expected_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "theme_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "complete",
        "expected_count",
        "theme_ids"
      ],
      "additionalProperties": false
    },
    "themes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/theme"
      }
    },
    "documents": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "format": "uri",
        "pattern": "^https://"
      },
      "additionalProperties": {
        "$ref": "#/$defs/document"
      }
    },
    "failures": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/failure"
      }
    }
  },
  "required": [
    "schema_version",
    "source",
    "started_at",
    "finished_at",
    "status",
    "discovery",
    "themes",
    "documents",
    "failures"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TerminalColors theme snapshot",
  "description": "Source-preserving catalog snapshot; partial exports report missing coverage.",
  "$defs": {
    "color": {
      "type": "string",
      "pattern": "^#[0-9A-F]{6}([0-9A-F]{2})?$",
      "description": "Normalized sRGB color, with uncomposited alpha when present."
    },
    "document": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "encoding": {
          "const": "utf-8"
        },
        "fetched_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$",
          "description": "UTC timestamp."
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "text",
        "media_type",
        "encoding",
        "fetched_at",
        "sha256"
      ],
      "additionalProperties": false
    },
    "failure": {
      "type": "object",
      "properties": {
        "stage": {
          "enum": [
            "discovery",
            "fetch",
            "parse",
            "normalize",
            "validation"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "target_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "target_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "stage",
        "message"
      ],
      "additionalProperties": false
    },
    "theme": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*/[a-z0-9][a-z0-9_-]*$"
        },
        "family_id": {
          "type": "string",
          "minLength": 1
        },
        "variant_id": {
          "type": "string",
          "minLength": 1
        },
        "family_name": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "mode": {
          "enum": [
            "dark",
            "light",
            "unknown"
          ]
        },
        "palette": {
          "type": "object",
          "properties": {
            "background": {
              "$ref": "#/$defs/color"
            },
            "foreground": {
              "$ref": "#/$defs/color"
            },
            "accent": {
              "$ref": "#/$defs/color"
            },
            "ansi": {
              "type": "array",
              "minItems": 16,
              "maxItems": 16,
              "items": {
                "$ref": "#/$defs/color"
              },
              "description": "ANSI indexes 0–15; repeated color values are valid."
            }
          },
          "required": [
            "background",
            "foreground",
            "accent",
            "ansi"
          ],
          "additionalProperties": false
        },
        "originals": {
          "type": "object",
          "properties": {
            "family": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            },
            "svg": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            }
          },
          "required": [
            "family",
            "svg"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "family_id",
        "variant_id",
        "family_name",
        "name",
        "url",
        "mode",
        "palette",
        "originals"
      ],
      "additionalProperties": false
    }
  }
}
